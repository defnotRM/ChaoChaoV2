# ==============================================================================
# ChaoChao Environment Variables (Supabase Cloud Configuration)
# ==============================================================================

# Supabase Cloud Project URL
# Find in: Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon (Publishable) Key
# Find in: Supabase Dashboard > Project Settings > API > Project API Keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role (Secret) Key (Backend only - NEVER expose to browser)
# Find in: Supabase Dashboard > Project Settings > API > Project API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
